generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  email     String   @unique
  password  String
  role      String   @default("OWNER")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Voucher {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  packageName String
  quota       Int      @default(1)
  used        Int      @default(0)
  price       Int      @default(0)
  extraPrint  Int      @default(0)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model FrameTemplate {
  id              String   @id @default(cuid())
  name            String
  category        String
  layoutType      String   @default("PHOTO_STRIP")
  backgroundColor String   @default("#FFFFFF")

  thumbnail       String?
  preview         String?

  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  layers          FrameLayer[]
}

model FrameLayer {
  id          String   @id @default(cuid())

  frameId     String

  type        String
  name        String

  visible     Boolean  @default(true)
  locked      Boolean  @default(false)

  x           Float
  y           Float
  width       Float
  height      Float

  src         String?
  photoIndex  Int?

  zIndex      Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  frame FrameTemplate @relation(fields: [frameId], references: [id], onDelete: Cascade)

  @@index([frameId])
}
