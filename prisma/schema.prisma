generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  email     String   @unique
  password  String
  role      String   @default("OWNER")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Voucher {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  packageName String
  quota       Int      @default(1)
  used        Int      @default(0)
  price       Int      @default(0)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}